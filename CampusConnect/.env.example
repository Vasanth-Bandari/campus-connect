# ============================================================
# CampusConnect – Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusconnect
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- JWT ---
JWT_SECRET=replace_with_at_least_64_char_random_string_never_commit_this
JWT_EXPIRATION_MS=86400000

# --- Server ---
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# --- File Upload ---
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5

# --- Admin Seed Account (used only on first startup) ---
ADMIN_EMAIL=admin@campusconnect.edu
ADMIN_PASSWORD=Admin@123_change_me_immediately

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev
